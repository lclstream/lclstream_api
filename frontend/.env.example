# Copy to .env.local and adjust for your setup.
#
# Absolute base URL of the lclstream_api backend. Requests are made directly
# from the browser (no dev-server proxy), so this must be an origin the
# browser can reach. Default here assumes a backend running natively on this
# machine. Point this at the real dev k8s deployment instead.
VITE_API_URL=http://localhost:8000

VITE_DEV_BEARER_TOKEN=
