#!/usr/bin/env bash
#
# s3df-login — OAuth2 Device Authorization Grant login for S3DF
#
# Authenticates against dex.slac.stanford.edu using the device code flow
# (RFC 8628) and writes the access token to ~/.s3df-access-token.
# Token metadata (for caching/refresh) is stored in ~/.s3df-token.json.
#
# Usage:
#   s3df login              Authenticate (uses cached token if still valid)
#   s3df login --force      Force fresh authentication, ignore cached token
#   s3df login --status     Show current token status without logging in
#   s3df login --qr         Show a QR code for the authentication URL
#   s3df login --help       Show this help message
#
set -euo pipefail

# ── Configuration (override via environment) ────────────────────────────────

S3DF_ISSUER="${S3DF_ISSUER:-https://dex.slac.stanford.edu}"
S3DF_CLIENT_ID="${S3DF_CLIENT_ID:-s3df}"
S3DF_SCOPES="${S3DF_SCOPES:-openid profile email groups offline_access}"
S3DF_TOKEN_FILE="${S3DF_TOKEN_FILE:-${HOME}/.s3df-access-token}"
S3DF_TOKEN_META="${S3DF_TOKEN_META:-${HOME}/.s3df-token.json}"

# ── Helpers ─────────────────────────────────────────────────────────────────

die()  { printf 'error: %s\n' "$*" >&2; exit 1; }
info() { printf '%s\n' "$*" >&2; }

usage() {
    cat <<'EOF'
s3df login — Authenticate to S3DF via device code flow

Usage:
  s3df login              Authenticate (uses cached token if valid)
  s3df login --force      Force fresh authentication
  s3df login --status     Show current token status
  s3df login --qr         Show a QR code for the authentication URL
  s3df login --help       Show this help message

Environment variables:
  S3DF_ISSUER       Dex issuer URL        (default: https://dex.slac.stanford.edu)
  S3DF_CLIENT_ID    OAuth2 client ID      (default: s3df)
  S3DF_SCOPES       Space-separated scopes (default: openid profile email groups offline_access)
  S3DF_TOKEN_FILE   Token file path       (default: ~/.s3df-access-token)
  S3DF_TOKEN_META   Token metadata path   (default: ~/.s3df-token.json)
EOF
}

check_deps() {
    local missing=()
    command -v curl >/dev/null 2>&1 || missing+=(curl)
    command -v jq   >/dev/null 2>&1 || missing+=(jq)
    if [[ ${#missing[@]} -gt 0 ]]; then
        die "missing required tools: ${missing[*]}"
    fi
}

# Decode a JWT payload (no signature verification — display only).
jwt_payload() {
    local token="$1"
    local payload
    payload="$(printf '%s' "$token" | cut -d. -f2)"
    # Add base64 padding if needed
    local pad=$(( 4 - ${#payload} % 4 ))
    [[ $pad -lt 4 ]] && payload="${payload}$(printf '=%.0s' $(seq 1 "$pad"))"
    printf '%s' "$payload" | base64 -d 2>/dev/null
}

# ── OIDC discovery ──────────────────────────────────────────────────────────

discover_endpoints() {
    local discovery_url="${S3DF_ISSUER}/.well-known/openid-configuration"
    info "Discovering endpoints from ${discovery_url} ..."

    local response
    response="$(curl -sS --fail "$discovery_url")" \
        || die "failed to fetch OIDC discovery document from ${discovery_url}"

    DEVICE_ENDPOINT="$(printf '%s' "$response" | jq -r '.device_authorization_endpoint // empty')"
    TOKEN_ENDPOINT="$(printf '%s' "$response" | jq -r '.token_endpoint // empty')"

    [[ -n "$DEVICE_ENDPOINT" ]] || die "no device_authorization_endpoint in discovery document"
    [[ -n "$TOKEN_ENDPOINT" ]]  || die "no token_endpoint in discovery document"
}

# ── Token cache ─────────────────────────────────────────────────────────────

# Read the cached token metadata. Sets CACHED_* variables.
# Returns 0 if the metadata file exists and is valid JSON, 1 otherwise.
load_cached_token() {
    [[ -f "$S3DF_TOKEN_META" ]] || return 1

    local data
    data="$(cat "$S3DF_TOKEN_META")"

    # Validate it's JSON before parsing
    printf '%s' "$data" | jq empty 2>/dev/null || return 1

    CACHED_ID_TOKEN="$(printf '%s' "$data"      | jq -r '.id_token // empty')"
    CACHED_ACCESS_TOKEN="$(printf '%s' "$data"   | jq -r '.access_token // empty')"
    CACHED_REFRESH_TOKEN="$(printf '%s' "$data"  | jq -r '.refresh_token // empty')"
    CACHED_EXPIRES_AT="$(printf '%s' "$data"     | jq -r '.expires_at // "0"')"

    [[ -n "$CACHED_ID_TOKEN" ]] || return 1
    return 0
}

# Check whether the cached token has not expired (with 60 s margin).
is_token_valid() {
    local now
    now="$(date +%s)"
    [[ "$CACHED_EXPIRES_AT" -gt $((now + 60)) ]]
}

save_token() {
    local id_token="$1"
    local access_token="$2"
    local refresh_token="$3"
    local token_type="$4"
    local expires_in="$5"

    local expires_at
    expires_at="$(( $(date +%s) + expires_in ))"

    # Write raw access token to the token file
    printf '%s' "$access_token" > "$S3DF_TOKEN_FILE"
    chmod 600 "$S3DF_TOKEN_FILE"

    # Write full metadata to the meta file (for cache/refresh logic)
    jq -n \
        --arg id_token      "$id_token" \
        --arg access_token  "$access_token" \
        --arg refresh_token "$refresh_token" \
        --arg token_type    "$token_type" \
        --argjson expires_at "$expires_at" \
        --arg issuer        "$S3DF_ISSUER" \
        --arg client_id     "$S3DF_CLIENT_ID" \
        '{
            id_token:      $id_token,
            access_token:  $access_token,
            refresh_token: $refresh_token,
            token_type:    $token_type,
            expires_at:    $expires_at,
            issuer:        $issuer,
            client_id:     $client_id
        }' > "$S3DF_TOKEN_META"

    chmod 600 "$S3DF_TOKEN_META"
}

print_token_status() {
    local id_token="$1"
    local expires_at="$2"

    local payload
    payload="$(jwt_payload "$id_token")"

    local email
    email="$(printf '%s' "$payload" | jq -r '.email // .sub // "unknown"')"

    local now
    now="$(date +%s)"
    local remaining=$(( expires_at - now ))

    if [[ $remaining -gt 0 ]]; then
        local hours=$(( remaining / 3600 ))
        local mins=$(( (remaining % 3600) / 60 ))
        info "Logged in as: ${email}"
        info "Token expires in: ${hours}h ${mins}m"
    else
        info "Token for ${email} has expired."
    fi
}

# ── Token refresh ───────────────────────────────────────────────────────────

try_refresh() {
    [[ -n "${CACHED_REFRESH_TOKEN:-}" ]] || return 1
    [[ -n "${TOKEN_ENDPOINT:-}" ]]       || discover_endpoints

    info "Refreshing token ..."

    local response http_code body
    response="$(curl -sS -w '\n%{http_code}' -X POST "$TOKEN_ENDPOINT" \
        -d grant_type=refresh_token \
        -d "refresh_token=${CACHED_REFRESH_TOKEN}" \
        -d "client_id=${S3DF_CLIENT_ID}")"

    http_code="$(printf '%s' "$response" | tail -1)"
    body="$(printf '%s' "$response" | sed '$d')"

    [[ "$http_code" == "200" ]] || return 1

    local id_token access_token refresh_token token_type expires_in
    id_token="$(printf '%s' "$body"      | jq -r '.id_token // empty')"
    access_token="$(printf '%s' "$body"  | jq -r '.access_token // empty')"
    refresh_token="$(printf '%s' "$body" | jq -r '.refresh_token // empty')"
    token_type="$(printf '%s' "$body"    | jq -r '.token_type // "Bearer"')"
    expires_in="$(printf '%s' "$body"    | jq -r '.expires_in // 3600')"

    [[ -n "$id_token" ]] || return 1

    # Preserve old refresh token if server didn't issue a new one
    [[ -n "$refresh_token" ]] || refresh_token="${CACHED_REFRESH_TOKEN}"

    save_token "$id_token" "$access_token" "$refresh_token" "$token_type" "$expires_in"
    info "Token refreshed successfully."
    print_token_status "$id_token" "$(( $(date +%s) + expires_in ))"
    return 0
}

# ── Device flow ─────────────────────────────────────────────────────────────

device_flow() {
    local show_qr="${1:-false}"
    [[ -n "${DEVICE_ENDPOINT:-}" ]] || discover_endpoints

    info "Starting device code flow ..."

    # 1. Request device code
    local response
    response="$(curl -sS --fail -X POST "$DEVICE_ENDPOINT" \
        -d "client_id=${S3DF_CLIENT_ID}" \
        -d "scope=${S3DF_SCOPES}")" \
        || die "failed to request device code from ${DEVICE_ENDPOINT}"

    local device_code user_code verification_uri expires_in interval
    device_code="$(printf '%s' "$response"      | jq -r '.device_code // empty')"
    user_code="$(printf '%s' "$response"        | jq -r '.user_code // empty')"
    verification_uri="$(printf '%s' "$response" | jq -r '.verification_uri // empty')"
    expires_in="$(printf '%s' "$response"       | jq -r '.expires_in // 1800')"
    interval="$(printf '%s' "$response"         | jq -r '.interval // 5')"

    local verification_uri_complete
    verification_uri_complete="$(printf '%s' "$response" | jq -r '.verification_uri_complete // empty')"

    [[ -n "$device_code" && -n "$user_code" ]] \
        || die "unexpected response from device endpoint: ${response}"

    # Build the direct URL (prefer server-provided, fall back to appending user_code)
    local direct_url="${verification_uri_complete:-${verification_uri}?user_code=${user_code}}"

    # 2. Display instructions
    printf '\n'
    printf '  Authenticate:  %s\n' "$direct_url"
    if $show_qr; then
        printf '\n'
        local script_dir
        script_dir="$(dirname "$(readlink -f "$0")")"
        local qr_cmd="${script_dir}/../lib/qr-terminal"
        if command -v qrencode >/dev/null 2>&1; then
            qrencode -t ANSIUTF8 -m 2 "$direct_url"
        elif [[ -x "$qr_cmd" ]]; then
            "$qr_cmd" "$direct_url"
        else
            info "  (QR code display unavailable)"
        fi
    fi
    printf '\n'
    info "Waiting for authorization (expires in ${expires_in}s) ..."

    # 3. Poll for token
    local deadline=$(( $(date +%s) + expires_in ))

    while [[ $(date +%s) -lt $deadline ]]; do
        sleep "$interval"

        local poll_response poll_http poll_body
        poll_response="$(curl -sS -w '\n%{http_code}' -X POST "$TOKEN_ENDPOINT" \
            -d grant_type=urn:ietf:params:oauth:grant-type:device_code \
            -d "device_code=${device_code}" \
            -d "client_id=${S3DF_CLIENT_ID}")"

        poll_http="$(printf '%s' "$poll_response" | tail -1)"
        poll_body="$(printf '%s' "$poll_response" | sed '$d')"

        # Success
        if [[ "$poll_http" == "200" ]]; then
            local id_token access_token refresh_token token_type tok_expires_in
            id_token="$(printf '%s' "$poll_body"      | jq -r '.id_token // empty')"
            access_token="$(printf '%s' "$poll_body"  | jq -r '.access_token // empty')"
            refresh_token="$(printf '%s' "$poll_body" | jq -r '.refresh_token // empty')"
            token_type="$(printf '%s' "$poll_body"    | jq -r '.token_type // "Bearer"')"
            tok_expires_in="$(printf '%s' "$poll_body" | jq -r '.expires_in // 3600')"

            [[ -n "$id_token" ]] || die "token response missing id_token"

            save_token "$id_token" "$access_token" "$refresh_token" "$token_type" "$tok_expires_in"
            printf '\n'
            info "Login successful."
            print_token_status "$id_token" "$(( $(date +%s) + tok_expires_in ))"
            return 0
        fi

        # Handle error responses
        local err
        err="$(printf '%s' "$poll_body" | jq -r '.error // empty')"

        case "${err}" in
            authorization_pending)
                # Still waiting — keep polling
                ;;
            slow_down)
                interval=$(( interval + 5 ))
                ;;
            access_denied)
                die "authorization denied by user"
                ;;
            expired_token)
                die "device code expired — please try again"
                ;;
            *)
                die "unexpected error from token endpoint: ${err:-HTTP ${poll_http}}"
                ;;
        esac
    done

    die "timed out waiting for authorization"
}

# ── Main ────────────────────────────────────────────────────────────────────

main() {
    local force=false
    local status_only=false
    local show_qr=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --force)  force=true; shift ;;
            --status) status_only=true; shift ;;
            --qr)     show_qr=true; shift ;;
            --help|-h) usage; exit 0 ;;
            -*) die "unknown flag: $1" ;;
            *)  die "unexpected argument: $1" ;;
        esac
    done

    check_deps

    # --status: just show current token state
    if $status_only; then
        if load_cached_token; then
            print_token_status "$CACHED_ID_TOKEN" "$CACHED_EXPIRES_AT"
        else
            info "No cached token found."
        fi
        exit 0
    fi

    # Try cached token (unless --force)
    if ! $force && load_cached_token; then
        if is_token_valid; then
            info "Already logged in (cached token is still valid)."
            print_token_status "$CACHED_ID_TOKEN" "$CACHED_EXPIRES_AT"
            exit 0
        fi

        # Token expired — try refresh before full device flow
        if try_refresh; then
            exit 0
        fi

        info "Cached token expired and refresh failed. Starting device flow ..."
    fi

    device_flow "$show_qr"
}

main "$@"
