# Copy to .env and fill in. See main.py for defaults of unset values.

# Defaults to ~/.s3df-access-token, written by scripts/s3df-login.
# LCLSTREAM_EXAMPLE_TOKEN_FILE=
# LCLSTREAM_EXAMPLE_API_URL=https://lcls-data-portal.slac.stanford.edu/lclstream-dev
# LCLSTREAM_EXAMPLE_SOURCE_IDENTIFIER=exp=mfx100848724,run=51,dir=/sdf/data/lcls/ds/prj/public01/xtc

# --- transfer_client.py (LCLSTREAM_CRYSTFEL_*) ---
# LCLSTREAM_CRYSTFEL_TOKEN_FILE=/run/s3df_token
# Ignored under submit_crystfel_nersc.py: --exp/--run win.
# LCLSTREAM_CRYSTFEL_SOURCE_IDENTIFIER=exp=mfx101592326,run=<run>
# Must be a project you can charge; see IRI /account/projects.
LCLSTREAM_CRYSTFEL_JOB_SPEC_ACCOUNT=LCLS:mfx101592326

# --- submit_crystfel_nersc.py (LCLSTREAM_NERSC_*) ---
# LCLSTREAM_NERSC_ACCOUNT=lcls
# LCLSTREAM_NERSC_DIRECTORY=/global/cfs/cdirs/lcls/crystfel-demo
# LCLSTREAM_NERSC_SCRIPT=/global/homes/p/psdatmgr/repos/github/lclstream/lclstream_api/client/example/crystfel_nersc.sh
# Staged to <directory>/.secrets/s3df_token at submit time.
# LCLSTREAM_NERSC_S3DF_TOKEN_FILE=~/.s3df-access-token
# Defaults to ~/.superfacility/psdatmgr* -- one file, 13-char client id
# on line 1, PEM below, chmod 600. Set only to point elsewhere.
# LCLSTREAM_NERSC_SFAPI_KEY=psdatmgr
# LCLSTREAM_NERSC_COMPUTE_RESOURCE=compute
# LCLSTREAM_NERSC_FS_RESOURCE=cfs
# LCLSTREAM_NERSC_QUEUE=regular
# LCLSTREAM_NERSC_DURATION=1800

# --- crystfel_nersc.sh, read on the NERSC side ---
# Our client image, built from this directory's Dockerfile.
# CLIENT_IMAGE=lclstream-client:latest
# CrystFEL, straight from upstream -- no rebuild when its args change.
# CRYSTFEL_IMAGE=crystfel:latest
# Geometry file, read from the job dir.
# CRYSTFEL_GEOM=jf16mgeom.geom
# Defaults to psdatmgr's sss_iri.keytab; siblings in the same dir
# are sss.keytab, rucio_sssp.keytab, bbr.keytab, sss_pmtester.keytab.
# XrdSecSSSKT=/global/homes/p/psdatmgr/.xrd/sss_iri.keytab
# XRD_URL=root://sdfdtn006.slac.stanford.edu:3091

# --- transfer_logs.py (LCLSTREAM_LOGS_*) ---
# fastcache_api's own log, read over the S3DF IRI filesystem.
# LCLSTREAM_LOGS_SUPERVISOR_LOG=/sdf/home/s/swelborn/.local/state/fastcache_api/fastcache-api.log
# LCLSTREAM_LOGS_API_URL=https://lcls-data-portal.slac.stanford.edu/lclstream-dev
# LCLSTREAM_LOGS_TOKEN_FILE=~/.s3df-access-token
